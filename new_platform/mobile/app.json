{
  "expo": {
    "name": "HADES Trading",
    "slug": "hades-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0f"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hades.trading",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "HADES necesita acceso a FaceID para autenticar operaciones seguras.",
        "NSCameraUsageDescription": "HADES necesita acceso a la cámara para escanear códigos QR de pagos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0f"
      },
      "package": "com.hades.trading",
      "versionCode": 1,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "CAMERA",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7c3aed",
          "sounds": ["./assets/notification-sound.wav"]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir que HADES use FaceID para autenticar operaciones."
        }
      ]
    ],
    "scheme": "hades-mobile",
    "experiments": {
      "typedRoutes": true
    }
  }
}
