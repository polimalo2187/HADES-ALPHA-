# ==============================
# CONFIGURACIÓN BASE
# ==============================
ENVIRONMENT=production
MONGODB_URI=mongodb+srv://USER:PASS@HOST/?retryWrites=true&w=majority
DATABASE_NAME=hades_db

# ==============================
# SERVER WEB/API
# ==============================
APP_RUNTIME_ROLE=web
PORT=8000
HOST=0.0.0.0

# ==============================
# AUTENTICACIÓN (Teléfono + Contraseña)
# ==============================
AUTH_SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-seguro-min-32chars
AUTH_SESSION_TTL_SECONDS=43200
AUTH_PASSWORD_SALT_ROUNDS=12
AUTH_TOKEN_TTL_SECONDS=2592000

# ==============================
# CORS ORIGINS
# ==============================
CORS_ORIGINS=https://tu-dominio.com,https://app.tu-dominio.com

# ==============================
# PUSH NOTIFICATIONS INTERNAS (WebSockets)
# ==============================
PUSH_ENABLED=true
PUSH_MAX_CONNECTIONS_PER_USER=5
PUSH_HEARTBEAT_INTERVAL_SECONDS=30
PUSH_RECONNECT_DELAY_MS=3000

# ==============================
# PAGOS USDT BEP-20
# ==============================
PAYMENT_NETWORK=bep20
PAYMENT_TOKEN_SYMBOL=USDT
PAYMENT_TOKEN_CONTRACT=0x55d398326f99059ff775485246999027b3197955
PAYMENT_RECEIVER_ADDRESS=0xTU_WALLET_ADDRESS_AQUI
BSC_RPC_HTTP_URL=https://bsc-dataseed.binance.org
PAYMENT_MIN_CONFIRMATIONS=3
PAYMENT_ORDER_TTL_MINUTES=30
PAYMENT_UNIQUE_MAX_DELTA=0.150
PAYMENT_TOKEN_DECIMALS=18
PAYMENT_LOOKBACK_BLOCKS=2500

# ==============================
# SCANNER DE SEÑALES
# ==============================
SCANNER_KLINE_LIMIT_5M=260
SCANNER_KLINE_LIMIT_15M=260
SCANNER_KLINE_LIMIT_1H=260
SCANNER_SYMBOL_CONCURRENCY=24
SCANNER_MAX_REQUESTS_PER_SECOND=8
SCANNER_MAX_BURST=16
REQUEST_MAX_RETRIES=4
REQUEST_RETRY_BASE_SLEEP=0.6
SCANNER_ENABLE_HTF_CACHE=true
SCANNER_5M_CACHE_SECONDS=0
SCANNER_HTF_STALE_GRACE_SECONDS=900
ACTIVE_SYMBOLS_CACHE_SECONDS=300
SCANNER_BOOTSTRAP_BATCH_SIZE=48
SCANNER_15M_REFRESH_BATCH_SIZE=20
SCANNER_1H_REFRESH_BATCH_SIZE=8

# ==============================
# UMBRALES DE SCORE POR TIER
# ==============================
PREMIUM_RAW_SCORE_MIN=79
PLUS_RAW_SCORE_MIN=74
FREE_RAW_SCORE_MIN=66

# ==============================
# FILTROS BREAKOUT + RESET
# ==============================
FREE_ADX_MIN=15.8
PLUS_ADX_MIN=17.1
PREMIUM_ADX_MIN=17.8
FREE_ATR_PCT_MIN=0.0020
PLUS_ATR_PCT_MIN=0.0023
PREMIUM_ATR_PCT_MIN=0.0025
FREE_ATR_PCT_MAX=0.0142
PLUS_ATR_PCT_MAX=0.0128
PREMIUM_ATR_PCT_MAX=0.0122
FREE_MIN_BODY_RATIO_BREAKOUT=0.22
PLUS_MIN_BODY_RATIO_BREAKOUT=0.27
PREMIUM_MIN_BODY_RATIO_BREAKOUT=0.30
FREE_MIN_BODY_RATIO_CONTINUATION=0.16
PLUS_MIN_BODY_RATIO_CONTINUATION=0.19
PREMIUM_MIN_BODY_RATIO_CONTINUATION=0.21

# ==============================
# FILTROS CONTINUACIÓN PRE-RESET
# ==============================
FREE_MIN_REL_VOLUME_CONTINUATION=0.95
PLUS_MIN_REL_VOLUME_CONTINUATION=1.02
PREMIUM_MIN_REL_VOLUME_CONTINUATION=1.10
FREE_MIN_CLOSE_POSITION_CONTINUATION=0.50
PLUS_MIN_CLOSE_POSITION_CONTINUATION=0.58
PREMIUM_MIN_CLOSE_POSITION_CONTINUATION=0.64
FREE_MIN_POST_BREAKOUT_PROGRESS_ATR=0.03
PLUS_MIN_POST_BREAKOUT_PROGRESS_ATR=0.05
PREMIUM_MIN_POST_BREAKOUT_PROGRESS_ATR=0.07

# ==============================
# FILTROS LIQUIDITY SWEEP REVERSAL
# ==============================
LSR_FREE_MIN_SWEEP_ATR=0.18
LSR_PLUS_MIN_SWEEP_ATR=0.24
LSR_PREMIUM_MIN_SWEEP_ATR=0.30
LSR_FREE_MIN_REL_VOLUME=0.84
LSR_PLUS_MIN_REL_VOLUME=0.95
LSR_PREMIUM_MIN_REL_VOLUME=1.03
LSR_FREE_MIN_CONFIRM_REL_VOLUME=0.93
LSR_PLUS_MIN_CONFIRM_REL_VOLUME=1.02
LSR_PREMIUM_MIN_CONFIRM_REL_VOLUME=1.10
LSR_FREE_MIN_BODY_RATIO_CONFIRMATION=0.22
LSR_PLUS_MIN_BODY_RATIO_CONFIRMATION=0.26
LSR_PREMIUM_MIN_BODY_RATIO_CONFIRMATION=0.30
LSR_FREE_MIN_CLOSE_POSITION=0.57
LSR_PLUS_MIN_CLOSE_POSITION=0.63
LSR_PREMIUM_MIN_CLOSE_POSITION=0.69
LSR_FREE_MIN_RR=0.96
LSR_PLUS_MIN_RR=1.06
LSR_PREMIUM_MIN_RR=1.14

# ==============================
# VENTANAS DE SEÑAL
# ==============================
MIN_ENTRY_WAIT_MINUTES=15
MAX_ENTRY_WAIT_MINUTES=60
ENTRY_WAIT_BUFFER_MINUTES=3
ENTRY_ZONE_MIN_PCT=0.0015
ENTRY_ZONE_MAX_PCT=0.0035
ENTRY_ZONE_RISK_FRACTION=0.22

# ==============================
# RETENCIÓN DE DATOS
# ==============================
BASE_SIGNALS_RETENTION_DAYS=180
USER_SIGNALS_RETENTION_DAYS=45
SIGNAL_RESULTS_RETENTION_DAYS=365
SIGNAL_HISTORY_RETENTION_DAYS=730

# ==============================
# SCHEDULER
# ==============================
SCHEDULER_CHECK_INTERVAL=300
SCHEDULER_BATCH_SIZE=100
SCHEDULER_EVALUATION_LIMIT=200
SCHEDULER_STATS_REFRESH_EVERY_LOOPS=3
SCHEDULER_HISTORY_BACKFILL_EVERY_LOOPS=6

# ==============================
# ADMINISTRADORES DEL SISTEMA
# ==============================
ADMIN_USER_IDS=123456789,987654321
ADMIN_WHATSAPPS=+1234567890,+0987654321

# ==============================
# OBSERVABILIDAD
# ==============================
HEALTH_DEFAULT_STALE_AFTER_SECONDS=300
HEALTH_MINIAPP_STALE_AFTER_SECONDS=180
HEALTH_SCANNER_STALE_AFTER_SECONDS=240
HEALTH_SCHEDULER_STALE_AFTER_SECONDS=900

# ==============================
# BINANCE API (OPCIONAL PARA DATOS)
# ==============================
BINANCE_API_KEY=
BINANCE_API_SECRET=
