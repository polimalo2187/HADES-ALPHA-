```gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.py~
*.py.class
*.py.backup
*.swp
*.swo

# Virtual environments
venv/
.venv/
env/
.env/

# Dependencies
pip-wheel-metadata/
requirements.txt.bak
.tox/
.coverage
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/
.installed.cfg
*.egg

# Logs
*.log
*.log.*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Icon?
```