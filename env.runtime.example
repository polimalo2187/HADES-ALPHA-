# ==============================
# Base común
# ==============================
ENVIRONMENT=production
MONGODB_URI=mongodb+srv://USER:PASS@HOST/?retryWrites=true&w=majority
DATABASE_NAME=hades_db
BOT_TOKEN=123456:telegram-token

# ==============================
# Web / MiniApp
# ==============================
ENABLE_MINI_APP_SERVER=true
APP_RUNTIME_ROLE=web
MINI_APP_URL=https://tu-dominio.com/miniapp
MINI_APP_SESSION_SECRET=cambia-esto-por-un-secreto-largo
MINI_APP_CORS_ORIGINS=https://tu-dominio.com

# ==============================
# Oraculum premium bridge
# ==============================
# Dominio público de Oraculum. HADES generará links de vinculación hacia /auth/hades/link.
ORACULUM_URL=https://oraculum-production-ede3.up.railway.app
# El código temporal de vinculación dura poco; la sesión real de Oraculum dura hasta plan_end.
ORACULUM_LINK_TTL_SECONDS=60

# ==============================
# Dev auth (solo local / test)
# ==============================
MINI_APP_ALLOW_DEV_AUTH=false
MINI_APP_DEV_USER_ID=

# ==============================
# Scheduler
# ==============================
SCHEDULER_CHECK_INTERVAL=300
SCHEDULER_BATCH_SIZE=100
SCHEDULER_EVALUATION_LIMIT=200
SCHEDULER_STATS_REFRESH_EVERY_LOOPS=3
SCHEDULER_HISTORY_BACKFILL_EVERY_LOOPS=6

# ==============================
# Retención
# ==============================
BASE_SIGNALS_RETENTION_DAYS=180
USER_SIGNALS_RETENTION_DAYS=45
SIGNAL_RESULTS_RETENTION_DAYS=365
SIGNAL_HISTORY_RETENTION_DAYS=730

# ==============================
# Observabilidad (opcionales)
# ==============================
# HEALTH_DEFAULT_STALE_AFTER_SECONDS=300
# HEALTH_MINIAPP_STALE_AFTER_SECONDS=180
# HEALTH_BOT_STALE_AFTER_SECONDS=180
# HEALTH_SCANNER_STALE_AFTER_SECONDS=240
# HEALTH_SCHEDULER_STALE_AFTER_SECONDS=900


# ==============================
# Scanner (señales)
# ==============================
# Intervalo optimizado para reducir gasto de red sin cambiar lógica de señales.
SCAN_INTERVAL_SECONDS=45

# Importante: la estrategia usa EMA200. Necesitas suficiente histórico para evitar NaNs.
SCANNER_KLINE_LIMIT_5M=260
SCANNER_KLINE_LIMIT_15M=260
SCANNER_KLINE_LIMIT_1H=260

# Proveedores públicos de mercado, sin API keys.
# Orden recomendado: no poner Binance primero porque Railway puede recibir 451 por ubicación restringida.
MARKET_DATA_PROVIDERS=bybit,okx,binance
PUBLIC_MARKET_TIMEOUT_SECONDS=6
PUBLIC_MARKET_TICKERS_TTL_SECONDS=45
PUBLIC_MARKET_SYMBOL_DETAILS_TTL_SECONDS=120
PUBLIC_MARKET_KLINES_TTL_SECONDS=25
PUBLIC_MARKET_PROVIDER_HEALTH_ENABLED=true
PUBLIC_MARKET_PROVIDER_RESTRICTED_COOLDOWN_SECONDS=1800
PUBLIC_MARKET_PROVIDER_FORBIDDEN_COOLDOWN_SECONDS=300
PUBLIC_MARKET_PROVIDER_RATE_LIMIT_COOLDOWN_SECONDS=300
PUBLIC_MARKET_PROVIDER_5XX_COOLDOWN_SECONDS=60
PUBLIC_MARKET_SYMBOL_PROVIDER_MISS_TTL_SECONDS=900

# Control de carga hacia proveedores públicos (evita bans/rate limits por 429/418)
SCANNER_SYMBOL_CONCURRENCY=3
SCANNER_MAX_REQUESTS_PER_SECOND=2.5
SCANNER_MAX_BURST=4
REQUEST_MAX_RETRIES=4
REQUEST_RETRY_BASE_SLEEP=0.6

# Cache MTF: 15M/1H se reutilizan y, si cambia bucket, pueden servirse stale
# por una ventana corta mientras el scanner refresca HTF en lotes.
SCANNER_ENABLE_HTF_CACHE=true
SCANNER_5M_CACHE_SECONDS=60
SCANNER_HTF_STALE_GRACE_SECONDS=900
ACTIVE_SYMBOLS_CACHE_SECONDS=1800

# Warmup / refresco escalonado para no bombardear Binance en arranque frío.
SCANNER_BOOTSTRAP_BATCH_SIZE=24
SCANNER_15M_REFRESH_BATCH_SIZE=10
SCANNER_1H_REFRESH_BATCH_SIZE=4

# Si necesitas serializar requests (no recomendado salvo emergencia)
SCANNER_FORCE_REQUEST_DELAY=true
REQUEST_DELAY=0.15

PREMIUM_RAW_SCORE_MIN=79
PLUS_RAW_SCORE_MIN=74
FREE_RAW_SCORE_MIN=66

# Rebalance breakout + reset por tier.
# Objetivo: abrir ligeramente el embudo sin dejar seco Free/Plus/Premium,
# pero manteniendo la jerarquía de calidad entre perfiles.
FREE_ADX_MIN=15.8
PLUS_ADX_MIN=17.1
PREMIUM_ADX_MIN=17.8
FREE_ATR_PCT_MIN=0.0020
PLUS_ATR_PCT_MIN=0.0023
PREMIUM_ATR_PCT_MIN=0.0025
FREE_ATR_PCT_MAX=0.0142
PLUS_ATR_PCT_MAX=0.0128
PREMIUM_ATR_PCT_MAX=0.0122
FREE_MIN_BODY_RATIO_BREAKOUT=0.22
PLUS_MIN_BODY_RATIO_BREAKOUT=0.27
PREMIUM_MIN_BODY_RATIO_BREAKOUT=0.30
FREE_MIN_BODY_RATIO_CONTINUATION=0.16
PLUS_MIN_BODY_RATIO_CONTINUATION=0.19
PREMIUM_MIN_BODY_RATIO_CONTINUATION=0.21

# Filtro de continuación pre-reset
# Solo la vela a favor + cuerpo mínimo quedan como hard gate.
# close position / volumen relativo / progreso post-breakout ahora afinan score y tier.
FREE_MIN_REL_VOLUME_CONTINUATION=0.95
PLUS_MIN_REL_VOLUME_CONTINUATION=1.02
PREMIUM_MIN_REL_VOLUME_CONTINUATION=1.10
FREE_MIN_CLOSE_POSITION_CONTINUATION=0.50
PLUS_MIN_CLOSE_POSITION_CONTINUATION=0.58
PREMIUM_MIN_CLOSE_POSITION_CONTINUATION=0.64
FREE_MIN_POST_BREAKOUT_PROGRESS_ATR=0.03
PLUS_MIN_POST_BREAKOUT_PROGRESS_ATR=0.05
PREMIUM_MIN_POST_BREAKOUT_PROGRESS_ATR=0.07

# Rebalance liquidity sweep reversal para recortar expiradas.
# Objetivo: filtrar un poco mejor los setups flojos sin secar los tiers,
# endureciendo ligeramente sweep, volumen, confirmación, cierre y RR.
LSR_FREE_MIN_SWEEP_ATR=0.18
LSR_PLUS_MIN_SWEEP_ATR=0.24
LSR_PREMIUM_MIN_SWEEP_ATR=0.30
LSR_FREE_MIN_REL_VOLUME=0.84
LSR_PLUS_MIN_REL_VOLUME=0.95
LSR_PREMIUM_MIN_REL_VOLUME=1.03
LSR_FREE_MIN_CONFIRM_REL_VOLUME=0.93
LSR_PLUS_MIN_CONFIRM_REL_VOLUME=1.02
LSR_PREMIUM_MIN_CONFIRM_REL_VOLUME=1.10
LSR_FREE_MIN_BODY_RATIO_CONFIRMATION=0.22
LSR_PLUS_MIN_BODY_RATIO_CONFIRMATION=0.26
LSR_PREMIUM_MIN_BODY_RATIO_CONFIRMATION=0.30
LSR_FREE_MIN_CLOSE_POSITION=0.57
LSR_PLUS_MIN_CLOSE_POSITION=0.63
LSR_PREMIUM_MIN_CLOSE_POSITION=0.69
LSR_FREE_MIN_RR=0.96
LSR_PLUS_MIN_RR=1.06
LSR_PREMIUM_MIN_RR=1.14

# Endurecimiento direccional adicional para LONG, donde la calidad venía más débil.
# Se aplica encima del perfil base de cada tier.
# FREE: +0.04 sweep ATR, +0.06 vol confirm, +0.04 body confirm, +0.04 close pos, +0.10 RR
# PLUS: +0.05 sweep ATR, +0.07 vol confirm, +0.05 body confirm, +0.05 close pos, +0.12 RR
# PREMIUM: +0.07 sweep ATR, +0.09 vol confirm, +0.05 body confirm, +0.05 close pos, +0.16 RR

# Ventanas de señal breakout + reset
# entry_wait: cuánto tiempo puede esperar la señal a que toque la entrada
# market_validity: sigue controlado por MIN/MAX_SIGNAL_VALIDITY_MINUTES en app/signals.py
MIN_ENTRY_WAIT_MINUTES=15
MAX_ENTRY_WAIT_MINUTES=60
ENTRY_WAIT_BUFFER_MINUTES=3

# Guardas anti-señal tardía
# Si el precio ya avanzó demasiado desde la entrada modelo, no se envía la alerta pendiente.
# Pre-reset signals are gated by structural reset viability, not TP1 progress.

# Zona de entrada adaptativa (en vez de un 0.15% fijo demasiado estrecho)
ENTRY_ZONE_MIN_PCT=0.0015
ENTRY_ZONE_MAX_PCT=0.0035
ENTRY_ZONE_RISK_FRACTION=0.22

# HADES Sentinel bridge
SENTINEL_URL=https://tu-dominio-sentinel.com
SENTINEL_LINK_TTL_SECONDS=60


# ======================================================
# BREAKOUT + RESET RECEPTIVE FILTERS V1
# ======================================================
# No cambia raw score gates. Solo relaja filtros terminales:
# breakout_shape, atr_pct, adx_strength, trend_structure y continuation.
PLUS_ADX_MIN=15.8
PLUS_ATR_PCT_MIN=0.0018
PLUS_ATR_PCT_MAX=0.0148
PLUS_MIN_BODY_RATIO_BREAKOUT=0.23
PLUS_MIN_BODY_RATIO_CONTINUATION=0.15
PLUS_MIN_EXTENSION_ATR=0.16
PLUS_MAX_EXTENSION_ATR=0.94
PLUS_MIN_BREAKOUT_OVERSHOOT_ATR=0.07
PLUS_MIN_PRE_RESET_SPACE_ATR=0.05
PLUS_MIN_REL_VOLUME_CONTINUATION=0.92
PLUS_MIN_CLOSE_POSITION_CONTINUATION=0.53
PLUS_MIN_POST_BREAKOUT_PROGRESS_ATR=0.035

PREMIUM_ADX_MIN=16.4
PREMIUM_ATR_PCT_MIN=0.0020
PREMIUM_ATR_PCT_MAX=0.0140
PREMIUM_MIN_BODY_RATIO_BREAKOUT=0.26
PREMIUM_MIN_BODY_RATIO_CONTINUATION=0.17
PREMIUM_MIN_EXTENSION_ATR=0.20
PREMIUM_MAX_EXTENSION_ATR=0.86
PREMIUM_MIN_BREAKOUT_OVERSHOOT_ATR=0.10
PREMIUM_MIN_PRE_RESET_SPACE_ATR=0.08
PREMIUM_MIN_REL_VOLUME_CONTINUATION=1.00
PREMIUM_MIN_CLOSE_POSITION_CONTINUATION=0.61
PREMIUM_MIN_POST_BREAKOUT_PROGRESS_ATR=0.055


# ======================================================
# OPERATIONAL MARKET REGIME ROUTER V3
# ======================================================
# HADES no debe quedar muerto por risk_off amplio.
# continuation_clean -> Breakout + Reset
# sweep/chop/trampa/risk_off normal -> Liquidity Sweep Reversal
# Solo bloquear si activas explícitamente terminal risk-off.
MARKET_REGIME_TERMINAL_RISK_OFF=false
MARKET_REGIME_RISK_OFF_ROUTE_TO_LIQUIDITY=true
MARKET_REGIME_FAIL_OPEN=true


# ======================================================
# OPERATIONAL STRATEGY RECEPTIVITY V4
# ======================================================
ROUTER_TRY_ALTERNATE_STRATEGY=true

# Liquidity Sweep receptive defaults
LSR_FREE_ATR_PCT_MIN=0.0012
LSR_FREE_ATR_PCT_MAX=0.0260
LSR_FREE_LIQUIDITY_TOLERANCE_ATR=0.56
LSR_FREE_MIN_SWEEP_ATR=0.07
LSR_FREE_MIN_REL_VOLUME=0.70
LSR_FREE_MIN_CONFIRM_REL_VOLUME=0.72
LSR_FREE_MIN_BODY_RATIO_RECOVERY=0.14
LSR_FREE_MIN_BODY_RATIO_CONFIRMATION=0.12
LSR_FREE_MIN_CLOSE_POSITION=0.48
LSR_FREE_MIN_RR=0.82
LSR_FREE_HTF_PRICE_TOLERANCE=0.0140
LSR_FREE_HTF_TREND_TOLERANCE=0.0240
LSR_FREE_HTF_REQUIRED_SCORE=1

LSR_PLUS_ATR_PCT_MIN=0.0015
LSR_PLUS_ATR_PCT_MAX=0.0240
LSR_PLUS_LIQUIDITY_TOLERANCE_ATR=0.50
LSR_PLUS_MIN_SWEEP_ATR=0.10
LSR_PLUS_MIN_REL_VOLUME=0.76
LSR_PLUS_MIN_CONFIRM_REL_VOLUME=0.82
LSR_PLUS_MIN_BODY_RATIO_RECOVERY=0.17
LSR_PLUS_MIN_BODY_RATIO_CONFIRMATION=0.15
LSR_PLUS_MIN_CLOSE_POSITION=0.53
LSR_PLUS_MIN_RR=0.90
LSR_PLUS_HTF_PRICE_TOLERANCE=0.0110
LSR_PLUS_HTF_TREND_TOLERANCE=0.0200
LSR_PLUS_HTF_REQUIRED_SCORE=1

LSR_PREMIUM_ATR_PCT_MIN=0.0018
LSR_PREMIUM_ATR_PCT_MAX=0.0225
LSR_PREMIUM_LIQUIDITY_TOLERANCE_ATR=0.44
LSR_PREMIUM_MIN_SWEEP_ATR=0.14
LSR_PREMIUM_MIN_REL_VOLUME=0.84
LSR_PREMIUM_MIN_CONFIRM_REL_VOLUME=0.90
LSR_PREMIUM_MIN_BODY_RATIO_RECOVERY=0.20
LSR_PREMIUM_MIN_BODY_RATIO_CONFIRMATION=0.18
LSR_PREMIUM_MIN_CLOSE_POSITION=0.58
LSR_PREMIUM_MIN_RR=0.98
LSR_PREMIUM_HTF_PRICE_TOLERANCE=0.0090
LSR_PREMIUM_HTF_TREND_TOLERANCE=0.0160
LSR_PREMIUM_HTF_REQUIRED_SCORE=1


# Hades AutoFutures bridge
HADES_AUTOFUTURES_FRONTEND_URL=https://hades-autofutures-production-32f9.up.railway.app
HADES_AUTOFUTURES_SSO_SECRET=change_me_same_value_as_autofutures_HADES_ALPHA_SSO_SECRET_min_32_chars
HADES_AUTOFUTURES_LINK_TTL_SECONDS=60
